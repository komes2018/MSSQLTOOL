<UserControl x:Class="MSSQLTool.GridQuickFilter.GridQuickFilterWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="750" MinHeight="450"
             Background="{DynamicResource ToolThemeBackgroundBrush}"
             Foreground="{DynamicResource ToolThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Search / Filter Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10"
                Background="{DynamicResource ToolThemeControlBackgroundBrush}"
                BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 查找/过滤:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Width="260" Height="26" VerticalContentAlignment="Center"
                         Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"
                         ToolTip="输入关键词进行即时搜索过滤，回车立即定位" />

                <TextBlock Text="目标列:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ColumnCombo" Width="180" Height="26" DisplayMemberPath="Label"
                          Margin="0,0,12,0" SelectionChanged="ColumnCombo_SelectionChanged"
                          ToolTip="选择要过滤的列（默认搜索全部列）" />

                <CheckBox x:Name="MatchCaseCheckBox" Content="区分大小写" VerticalAlignment="Center"
                          Margin="0,0,12,0" Click="Option_Click" />
                <CheckBox x:Name="ExactMatchCheckBox" Content="全字匹配" VerticalAlignment="Center"
                          Margin="0,0,12,0" Click="Option_Click" />

                <Button x:Name="ClearButton" Content="清除" Width="60" Height="26"
                        Click="ClearButton_Click" Margin="0,0,12,0" />

                <TextBlock x:Name="StatusText" Text="准备就绪" VerticalAlignment="Center"
                           Foreground="{DynamicResource ToolThemeForegroundBrush}" Margin="8,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- Main Data Grid -->
        <DataGrid x:Name="FilterDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource ToolThemeBackgroundBrush}"
                  RowBackground="{DynamicResource ToolThemeBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource ToolThemeControlBackgroundBrush}"
                  Foreground="{DynamicResource ToolThemeForegroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader" HeadersVisibility="All">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ToolThemeForegroundBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8,4"
                Background="{DynamicResource ToolThemeControlBackgroundBrush}"
                BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="复制为 CSV" Height="26" Padding="12,0" Margin="0,0,8,0" Click="CopyCsv_Click" />
                    <Button Content="复制为 TSV (Excel)" Height="26" Padding="12,0" Margin="0,0,8,0" Click="CopyTsv_Click" />
                    <Button Content="复制为 INSERT 语句" Height="26" Padding="12,0" Margin="0,0,8,0" Click="CopyInsert_Click" />
                    <Button Content="复制为 JSON" Height="26" Padding="12,0" Margin="0,0,8,0" Click="CopyJson_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="📊 导出到 Excel" Height="26" Padding="14,0" FontWeight="SemiBold" Click="ExportExcel_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
